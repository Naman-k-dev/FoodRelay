# Gemini API Configuration (Server-side only — NEVER use NEXT_PUBLIC_)
# For hackathon evaluation:
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.5-flash"

# Toggle AI Intake service on/off (defaults to true)
AI_ENABLED="true"
FEATURE_AI_INTAKE="true"

# Request limits and safety timeout (ms)
AI_REQUEST_TIMEOUT_MS="15000"
