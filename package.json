{
  "name": "foodrelay-ai",
  "version": "1.0.0",
  "private": true,
  "description": "FoodRelay AI — AI-assisted surplus food rescue and redistribution coordination platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "graft:build": "node scripts/build-graft-service.mjs",
    "graft:gen": "node scripts/build-graft-service.mjs && ./gg --runtime nodejs --modules ./services/foodrelay --graftOnly",
    "graft:start": "node scripts/build-graft-service.mjs && ./gg --runtime nodejs --modules ./services/foodrelay --port 8088 --httpPort 8089",
    "mcp:start": "npm run graft:start",
    "android:doctor": "node scripts/android-doctor.mjs",
    "android:dev": "node scripts/android-dev.mjs",
    "android:sync": "export ANDROID_HOME=$HOME/Library/Android/sdk JAVA_HOME=/opt/homebrew/opt/openjdk@21 && npx cap sync android",
    "android:build": "export ANDROID_HOME=$HOME/Library/Android/sdk JAVA_HOME=/opt/homebrew/opt/openjdk@21 && cd android && ./gradlew assembleDebug",
    "android:install": "adb reverse tcp:3000 tcp:3000 && adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "android:run": "adb shell am start -n com.impactforge.foodrelay/com.impactforge.foodrelay.MainActivity"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.7",
    "@capacitor/core": "^8.6.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.4",
    "@google/genai": "^3.6.1",
    "clsx": "^2.1.1",
    "graftcode-context": "^1.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
